{
  "version": 1,
  "self": "laptop",
  "defaultHost": "workstation",
  "hosts": {
    "laptop": { "ssh": null, "web": "http://100.x.y.z:7777" },
    "workstation": { "ssh": "workstation", "web": "http://100.x.y.z:7777" }
  },
  "web": {
    "port": 7777,
    "bind": "0.0.0.0",
    "dir": null,
    "ui": null,
    "editor": "vscode",
    "quickReplies": ["Continue.", "Yes", "No", "1", "2"],
    "models": [
      { "id": "", "label": "Default" },
      { "id": "claude-opus-5-5", "label": "Opus 5.5" },
      { "id": "claude-haiku-4-5-20251001", "label": "Haiku 4.5" }
    ],
    "autoName": { "enabled": true, "intervalMinutes": 5 },
    "grouping": { "enabled": true, "intervalMinutes": 10 },
    "briefs": { "enabled": false, "model": "haiku", "idleMs": 60000, "minIntervalMs": 900000, "maxDeltaChars": 12000, "maxCallsPerHour": 12 },
    "uploads": { "dir": "~/.local/share/fleet/uploads", "maxMB": 100, "retentionDays": 14 },
    "files": { "roots": [] }
  },
  "grouping": { "enabled": true, "model": "haiku", "host": "workstation" },
  "tmux": null,
  "fleetBin": null,
  "spawnDirs": [
    { "label": "Work", "paths": { "laptop": "~/Code/project", "workstation": "~/Code/project" } },
    { "label": "Notes", "paths": { "workstation": "~/Code/notes" } }
  ]
}
